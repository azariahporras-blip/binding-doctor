[0.033, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.000, "o", "\u001b[1m# Binding Doctor — 90s demo\u001b[0m\r\n"]
[2.516, "o", "\u001b[1m## 1. Empty Worker, no bindings declared\u001b[0m\r\n"]
[1.012, "o", "\u001b[2m$ cat demo/wrangler.toml\u001b[0m\r\n"]
[0.005, "o", "name = \"bdr-demo\"\r\nmain = \"src/index.ts\"\r\ncompatibility_date = \"2026-01-01\"\r\n"]
[1.509, "o", "\r\n\u001b[2m$ cat demo/src/index.ts\u001b[0m\r\n"]
[0.006, "o", "export interface Env {\r\n  CHAT_DB: D1Database;\r\n  UPLOADS_BUCKET: R2Bucket;\r\n  SESSIONS_KV: KVNamespace;\r\n  EVENTS_QUEUE: Queue;\r\n}\r\n\r\nexport default {\r\n  async fetch(req: Request, env: Env): Promise<Response> {\r\n    const id = crypto.randomUUID();\r\n    await env.SESSIONS_KV.put(id, \"hi\");\r\n    await env.EVENTS_QUEUE.send({ id });\r\n"]
[1.507, "o", "\u001b[1m## 2. bdr diff — finds the gap\u001b[0m\r\n"]
[1.011, "o", "\u001b[2m$ bdr diff demo\u001b[0m\r\n"]
[1.149, "o", "BINDING         KIND     DECL  REF  LIVE  STATUS          \r\n--------------  -------  ----  ---  ----  ----------------\r\nCHAT_DB         unknown  —     yes  —     missing-declared\r\nEVENTS_QUEUE    unknown  —     yes  —     missing-declared\r\nSESSIONS_KV     unknown  —     yes  —     missing-declared\r\nUPLOADS_BUCKET  unknown  —     yes  —     missing-declared\r\n"]
[1.518, "o", "\u001b[1m## 3. bdr apply — creates resources, wires bindings, runs migrations\u001b[0m\r\n"]
[1.010, "o", "\u001b[2m$ bdr apply demo --yes\u001b[0m\r\n"]
[1.041, "o", "BINDING         KIND     DECL  REF  LIVE  STATUS          \r\n--------------  -------  ----  ---  ----  ----------------\r\nCHAT_DB         unknown  —     yes  —     missing-declared\r\nEVENTS_QUEUE    unknown  —     yes  —     missing-declared\r\nSESSIONS_KV     unknown  —     yes  —     missing-declared\r\nUPLOADS_BUCKET  unknown  —     yes  —     missing-declared\r\n"]
[0.000, "o", "\r\nPlan:\r\n"]
[0.000, "o", "  create d1         CHAT_DB → bdr-demo-chat-db-uugc\r\n"]
[0.000, "o", "  create queue      EVENTS_QUEUE → bdr-demo-events-queue-5ahv\r\n  create kv         SESSIONS_KV → bdr-demo-sessions-kv-r1u4\r\n  create r2         UPLOADS_BUCKET → bdr-demo-uploads-bucket-c00t\r\n\r\nExecuting:\r\n"]
[1.180, "o", "  create d1        CHAT_DB → bdr-demo-chat-db-uugc (ca433793-54c4-4e11-acec-7524ddb76b2a)\r\n"]
[2.850, "o", "  create queue     EVENTS_QUEUE → bdr-demo-events-queue-5ahv (b4d04736a19d4e54897a306d8f7da62a)\r\n"]
[0.797, "o", "  create kv        SESSIONS_KV → bdr-demo-sessions-kv-r1u4 (10e0b2e5e80c47a9ac203312efba9fa8)\r\n"]
[0.614, "o", "  create r2        UPLOADS_BUCKET → bdr-demo-uploads-bucket-c00t (bdr-demo-uploads-bucket-c00t)\r\n"]
[0.005, "o", "\r\nWrote 4 bindings to /Users/ketchum/REPOS/binding-doctor/demo/wrangler.toml (backup: /Users/ketchum/REPOS/binding-doctor/demo/wrangler.toml.bak)\r\n"]
[0.561, "o", "\r\nMigrations [CHAT_DB ← bdr-demo-chat-db-uugc]:\r\n  applied  0001_init.sql\r\n"]
[1.523, "o", "\u001b[1m## 4. wrangler.toml is now ready to deploy\u001b[0m\r\n"]
[1.009, "o", "\u001b[2m$ cat demo/wrangler.toml\u001b[0m\r\n"]
[0.007, "o", "name = \"bdr-demo\"\r\nmain = \"src/index.ts\"\r\ncompatibility_date = \"2026-01-01\"\r\n\r\n[[d1_databases]]\r\nbinding = \"CHAT_DB\"\r\ndatabase_name = \"bdr-demo-chat-db-uugc\"\r\ndatabase_id = \"ca433793-54c4-4e11-acec-7524ddb76b2a\"\r\n\r\n[[queues.producers]]\r\nbinding = \"EVENTS_QUEUE\"\r\nqueue = \"bdr-demo-events-queue-5ahv\"\r\n\r\n[[kv_namespaces]]\r\nbinding = \"SESSIONS_KV\"\r\nid = \"10e0b2e5e80c47a9ac203312efba9fa8\"\r\n\r\n[[r2_buckets]]\r\nbinding = \"UPLOADS_BUCKET\"\r\nbucket_name = \"bdr-demo-uploads-bucket-c00t\"\r\n"]
[1.508, "o", "\u001b[1m## 5. Idempotent — re-run = zero diff\u001b[0m\r\n"]
[1.012, "o", "\u001b[2m$ bdr diff demo\u001b[0m\r\n"]
[1.071, "o", "BINDING         KIND   DECL  REF  LIVE          STATUS\r\n--------------  -----  ----  ---  ------------  ------\r\nCHAT_DB         d1     yes   yes  ca433793-54c  ok    \r\nEVENTS_QUEUE    queue  yes   yes  b4d04736a19d  ok    \r\nSESSIONS_KV     kv     yes   yes  10e0b2e5e80c  ok    \r\nUPLOADS_BUCKET  r2     yes   yes  bdr-demo-upl  ok    \r\n"]
[1.520, "o", "\u001b[1m## 6. Drift — somebody deletes a resource in the dashboard\u001b[0m\r\n"]
[1.023, "o", "\u001b[2m$ curl -X DELETE .../storage/kv/namespaces/10e0b2e5e80c47a9ac203312efba9fa8 (simulating dashboard delete)\u001b[0m\r\n"]
[1.836, "o", "\u001b[2m$ bdr diff demo\u001b[0m\r\n"]
[1.042, "o", "BINDING         KIND   DECL  REF  LIVE          STATUS      \r\n--------------  -----  ----  ---  ------------  ------------\r\nCHAT_DB         d1     yes   yes  ca433793-54c  ok          \r\nEVENTS_QUEUE    queue  yes   yes  b4d04736a19d  ok          \r\nSESSIONS_KV     kv     yes   yes  —             missing-live\r\nUPLOADS_BUCKET  r2     yes   yes  bdr-demo-upl  ok          \r\n"]
[1.518, "o", "\u001b[1m## 7. bdr apply heals the drift\u001b[0m\r\n"]
[1.009, "o", "\u001b[2m$ bdr apply demo --yes\u001b[0m\r\n"]
[1.046, "o", "BINDING         KIND   DECL  REF  LIVE          STATUS      \r\n--------------  -----  ----  ---  ------------  ------------\r\nCHAT_DB         d1     yes   yes  ca433793-54c  ok          \r\nEVENTS_QUEUE    queue  yes   yes  b4d04736a19d  ok          \r\nSESSIONS_KV     kv     yes   yes  —             missing-live\r\nUPLOADS_BUCKET  r2     yes   yes  bdr-demo-upl  ok          \r\n"]
